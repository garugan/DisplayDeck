{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DisplayDeck",
  "version": "0.1.0",
  "identifier": "com.displaydeck.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DisplayDeck",
        "width": 1080,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "zoomHotkeysEnabled": true,
        "fullscreen": false
      }
    ],
    "security": {
      "capabilities": ["main-readonly"],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; style-src 'self'; script-src 'self'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
